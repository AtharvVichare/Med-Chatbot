# Database Configuration
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+psycopg2://aarogya:your_postgres_password_here@localhost:5432/aarogya_db

# Security & CORS
JWT_SECRET_KEY=your_cryptographically_secure_random_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=aarogya-medical-knowledge
PINECONE_NAMESPACE=medical-references-v1

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

